<?php

/**
 * @file
 * Contains includes hook to generate help page.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\factory_lollipop\Hook\FactoryLollipopHelpHook;

/**
 * Implements hook_help().
 *
 * Legacy shim for Drupal < 11.1, see FactoryLollipopHelpHook.
 */
#[LegacyHook]
function factory_lollipop_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(FactoryLollipopHelpHook::class)($route_name, $route_match);
}
